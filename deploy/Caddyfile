{$KSIROVKA_DOMAIN:ksirovka.martinpolak.cz} {
	encode gzip zstd
	reverse_proxy ksirovka-api:3801

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		-X-Powered-By
	}

	# Náhled TV tabule v iframe na martinpolak.cz (freelancer portál).
	@tv path /tv /tv/*
	header @tv {
		-X-Frame-Options
		-Cross-Origin-Resource-Policy
		Content-Security-Policy "frame-ancestors 'self' https://martinpolak.cz https://www.martinpolak.cz"
	}
}
